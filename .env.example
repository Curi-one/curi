# Application environment: local | staging | production
APP_ENV=local

# Mock API — in-memory store with a constant sign-in code, i.e. NO real auth.
# Unset defaults to true only when APP_ENV=local; forced off in production.
USE_MOCK_API=true

# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only)
SUPABASE_SERVICE_ROLE_KEY=

# AI (server only)
PERPLEXITY_API_KEY=

# Stripe (server only) — test keys on staging / local; live on production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Academy $10/mo Price id (Dashboard → Products → price_…)
STRIPE_PRICE_ID=

# Observability (server)
SENTRY_DSN=

# Cron (server, when enabled)
CRON_SECRET=

# Daily lesson email (Resend — server only)
RESEND_API_KEY=
EMAIL_FROM=Curi <lessons@curi.one>

# HMAC key for signed email deep links (a valid link mints a session).
# Falls back to CRON_SECRET when unset. Generate: openssl rand -hex 32
EMAIL_LINK_SECRET=
